rules_version = '2';

// MyLink Firestore 보안 규칙
// ※ 이 파일은 기록용입니다. 실제 적용은 Firebase 콘솔 → Firestore Database → 규칙에서 하거나
//   firebase CLI(`firebase deploy --only firestore:rules`)로 배포해야 합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 계정 정보(이메일, 사진, 가입일 등): 본인만 읽기/쓰기
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 프로필(username, displayName, bio): 공개 페이지(/[username])용으로 누구나 읽기, 본인만 쓰기
    match /users/{uid}/profile/{docId} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // 링크: 본인은 전체, 방문자는 공개 링크(isActive == true)만 읽기 / 쓰기는 본인만
    match /users/{uid}/links/{linkId} {
      allow read: if isOwner(uid) || resource.data.isActive == true;
      allow write: if isOwner(uid);
    }

    // username → uid 인덱스: 공개 페이지 조회를 위해 단건 조회만 허용(목록 조회 불가)
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$')
        && !(username in ['mypage', 'api', 'admin', 'login', 'logout', 'signin', 'signup',
                          'settings', 'profile', 'user', 'users', 'links', 'mylink', 'about',
                          'help', 'support', 'static', 'public', 'assets', 'null', 'undefined']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
